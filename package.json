{
  "name": "pi-code-bundle",
  "version": "0.5.0",
  "type": "module",
  "description": "Complete pi-code extension suite with one shared runtime",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "index.ts"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "pi-code-context": "0.5.0",
    "pi-code-file-tools": "0.5.0",
    "pi-code-hooks": "0.5.0",
    "pi-code-integrations": "0.5.0",
    "pi-code-mem": "0.5.0",
    "pi-code-permissions": "0.5.0",
    "pi-code-planning": "0.5.0",
    "pi-code-prompts-skills": "0.5.0",
    "pi-code-session-ui": "0.5.0",
    "pi-code-subagents": "0.5.0",
    "pi-code-tasks": "0.5.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.19.19"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
